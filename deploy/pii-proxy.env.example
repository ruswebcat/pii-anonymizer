# PII anonymization proxy - environment file.
# Install to /etc/pii-proxy/pii-proxy.env with mode 0600.
#
# This file holds provider keys, so it is the most sensitive artifact on the
# host. It is deliberately kept outside the repository.

# --- binding ---------------------------------------------------------------
# Loopback only: the proxy is the single exit point for model traffic, and it
# must never be reachable from the network.
PII_PROXY_HOST=127.0.0.1
PII_PROXY_PORT=8791

# --- своя лексика организации ------------------------------------------------
# Бренд, филиалы, тарифы, город, свои адреса и телефоны ресепции — значения оператора, а не кода.
# Они законно попадают в словарь клиентов (карточка заведена на адрес клуба или на его телефон),
# поэтому без этого раздела прокси заменит адрес клуба как данные клиента.
# Через запятую, регистр не важен. ЗАПОЛНИТЬ СВОИМИ ЗНАЧЕНИЯМИ (здесь — выдуманные).
PII_PROXY_OWN_TERMS=Пример Спорт,ПримерСпорт,Пример,Спорт,Примерск,Северный,Центральный,Базовый,Квартальный,Годовой
PII_PROXY_OWN_ADDRESSES=б-р Садовая 3а,пр. Заводская 19А,ул. Садовая 12
PII_PROXY_OWN_PHONES=+7 (8481) 000-011,79001110011
PII_PROXY_OWN_SERVICE_OBJECTS=CRM,Admin CRM,Менеджер CRM
# Либо всё то же одним файлом JSON — путь к нему:
# PII_PROXY_OWN_VOCAB=/etc/pii-proxy/own-vocabulary.json
# Либо файл настроек целиком (образец — config.example.yaml в корне репозитория):
# PII_PROXY_CONFIG=/etc/pii-proxy/config.yaml

# --- служебная лексика (тарифы, клубы, услуги) --------------------------------
# Список замера для измерителя шума справочника (tools/dict_noise_report.py): тарифы, названия
# клубов и услуг, которые система учёта оставляет в поле ФИО. Отдельно от own-vocabulary: там
# стоп-лист распознавания, здесь список замера. Пусто — измеритель работает по общим категориям.
# ЗАПОЛНИТЬ СВОИМИ ЗНАЧЕНИЯМИ (здесь — выдуманные).
PII_PROXY_SERVICE_LEXICON=Годовой,Базовый,групповые занятия,персональная тренировка
# Либо файлом JSON с категориями — путь к нему:
# PII_PROXY_SERVICE_LEXICON_FILE=/etc/pii-proxy/service-lexicon.json

# --- keys ------------------------------------------------------------------
# Both files are generated by deploy/install.sh with mode 0600.
PII_PROXY_TOKEN_KEY_FILE=/var/lib/pii-proxy/token.key
PII_PROXY_FERNET_KEY_FILE=/var/lib/pii-proxy/fernet.key
# Separate secret for the dictionary digests: keeping it apart from the token key
# means the dictionary file cannot be used to link a token back to a client.
PII_PROXY_DICT_KEY_FILE=/var/lib/pii-proxy/dict.key

# --- state -----------------------------------------------------------------
PII_PROXY_MAP_DB=/var/lib/pii-proxy/pii_map.db
PII_PROXY_DICT=/var/lib/pii-proxy/pii_dict.json
PII_PROXY_AUDIT_LOG=/var/log/pii-proxy/audit.jsonl
# Журнал инцидентов (промахов детектора): каталог с файлами incidents-YYYY-WW.jsonl.
# По умолчанию — подкаталог incidents рядом с журналом аудита.
PII_PROXY_INCIDENT_LOG=/var/log/pii-proxy/incidents
PII_PROXY_TTL_DAYS=90
# Предел кэша блоков по числу записей (0 — выключить кэш).
PII_PROXY_CACHE_SIZE=512
# Предел того же кэша по объёму: бюджет в мегабайтах на обезличенные блоки.
# Считается в байтах, потому что живой диалог — это сотни сообщений на сотни
# килобайт: записей немного, а объём всё равно нужен целиком, иначе LRU вытеснит
# начало истории и оно будет сканироваться заново на каждом запросе.
PII_PROXY_BLOCK_CACHE_MB=64
# Полный выключатель кэша блоков (false — считать каждый блок заново).
PII_PROXY_BLOCK_CACHE=true

# --- policy ----------------------------------------------------------------
# Где восстанавливаются значения. Умолчание публичной сборки — ЛЮБОЙ канал (пустая строка или
# «*»): обобщённый продукт не знает имён каналов оператора. Для оператора, которому приватность
# важнее удобства, список следует СУЗИТЬ до доверенных каналов — восстановление в непубличном
# канале может вернуть персональные данные туда, где их быть не должно. Канал вне контура
# (внешний мессенджер) не восстанавливается никогда: служба откажется стартовать.
# Ниже — пример сужения; уберите строку или поставьте «*», чтобы вернуть умолчание «любой канал».
PII_PROXY_DETOK_CHANNELS=mattermost,local

# --- доверенные клиенты ------------------------------------------------------
# Кто получает восстановленные значения и чем клиент себя называет. Сторонние ИИ-приложения
# (Cursor, Claude Code, Codex и другие) меток Hermes не шлют, поэтому клиент опознаётся сам.
# Три способа по порядку: заголовок X-PII-Channel, ключ доступа X-PII-Client-Key (сравнивается
# по отпечатку), шаблон User-Agent. Компактная запись: канал=способ:значение через «;».
#   cursor=ua:Cursor/*        — десктопные приложения заголовки не настраивают
#   codex=ua:codex*
#   claude-code=key:sha256:<отпечаток>   — отпечаток: python3 -m src.client_identity "$(cat ключ)"
#   office=header:office      — клиент сам ставит X-PII-Channel: office
# Заголовок и User-Agent ПОДДЕЛЫВАЮТСЯ и границей безопасности не являются; граница — ключ на
# клиента и прослушивание только loopback. Честный разбор — docs/PRIVACY.md, раздел 3.1.
# Канал обязан быть разрешён и в PII_PROXY_DETOK_CHANNELS выше.
#PII_PROXY_TRUSTED_CLIENTS=cursor=ua:Cursor/*;codex=ua:codex*

# Поведение для клиента, который не назвался ничем: keep_codes (умолчание — значения не
# восстанавливаются) или restore (прежнее поведение: решение по списку каналов выше).
PII_PROXY_UNKNOWN_CLIENT=keep_codes
PII_PROXY_BLOCK_IMAGES=true

# Rehearsal switch: returns the anonymized payload without calling the provider.
# Keep false in production.
PII_PROXY_DRY_RUN=false

# --- enrichment layers -----------------------------------------------------
PII_PROXY_NER_ENABLED=true
PII_PROXY_NER_BACKEND=morphology

# k-anonymity policy for anything leaving the perimeter. Advisory by default;
# set PII_PROXY_RARITY_ENFORCE=true to block such requests outright.
PII_PROXY_RARITY_K=5
PII_PROXY_RARITY_ENFORCE=false

# --- provider credentials --------------------------------------------------
# These keys move here from the agent profile when the agent is switched to the
# proxy: from that moment the agent holds only a placeholder key.
DEEPSEEK_API_KEY=
NORDROUTER_API_KEY=

# --- alerts ----------------------------------------------------------------
# Optional: bot token and channel for journal alerts on block events.
MATTERMOST_URL=https://chat.example.com/api/v4/posts
MATTERMOST_TOKEN=
MATTERMOST_ALERT_CHANNEL=

# --- diagnostics -----------------------------------------------------------
PII_PROXY_LOG_LEVEL=INFO
PII_PROXY_REQUEST_TIMEOUT=120
